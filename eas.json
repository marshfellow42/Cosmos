{
  "cli": {
    "version": ">= 16.15.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_API_KEY": "EXPO_PUBLIC_API_KEY",
        "GOOGLE_SERVICES_JSON": "./android/app/google-services.json"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_API_KEY": "EXPO_PUBLIC_API_KEY",
        "GOOGLE_SERVICES_JSON": "./android/app/google-services.json"
      }
    },
    "production-github": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_API_KEY": "EXPO_PUBLIC_API_KEY",
        "GOOGLE_SERVICES_JSON": "./android/app/google-services.json"
      }
    },
    "production-play_store": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_API_KEY": "EXPO_PUBLIC_API_KEY",
        "GOOGLE_SERVICES_JSON": "./android/app/google-services.json"
      }
    }
  },
  "submit": {
    "production-play_store": {}
  }
}
